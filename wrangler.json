{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arca-computer-web",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "arca.computer",
      "custom_domain": true
    },
    {
      "pattern": "www.arca.computer",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
