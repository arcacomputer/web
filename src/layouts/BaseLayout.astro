---
export interface Props {
  title?: string;
}

const { title = 'Arca Computer — AI-native product company' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
<meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d1412" />
    <meta name="color-scheme" content="dark" />
    <meta
      name="description"
      content="Arca Computer, Inc. is an AI-native product company building open-source agent operations software, developer infrastructure, and consumer applications."
    />
    <meta name="author" content="Arca Computer, Inc." />
    <link rel="canonical" href="https://arca.computer/" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arca Computer" />
    <meta property="og:title" content="Arca Computer — The company is the computer." />
    <meta
      property="og:description"
      content="An AI-native product company building open-source agent operations software, developer infrastructure, and consumer applications from Santiago, Chile."
    />
    <meta property="og:url" content="https://arca.computer/" />
    <meta property="og:image" content="https://arca.computer/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Arca Computer — The company is the computer." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Arca Computer — The company is the computer." />
    <meta
      name="twitter:description"
      content="Products, specialized agents, and infrastructure. Built in Santiago and shipped in public."
    />
    <meta name="twitter:image" content="https://arca.computer/og-image.png" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles.css" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Arca Computer, Inc.",
        "alternateName": "Arca Computer",
        "url": "https://arca.computer/",
        "logo": "https://arca.computer/icon-512.png",
        "description": "An AI-native product company building open-source agent operations software, developer infrastructure, and consumer applications.",
        "foundingDate": "2026",
        "email": "contact@arca.computer",
        "founder": {
          "@type": "Person",
          "name": "Luis Felipe Abarca",
          "url": "https://felirami.com/"
        },
        "location": {
          "@type": "Place",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Santiago",
            "addressCountry": "CL"
          }
        },
        "sameAs": [
          "https://arcabot.ai/",
          "https://github.com/arcabotai",
          "https://farcaster.xyz/felirami.eth"
        ]
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
