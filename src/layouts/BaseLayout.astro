---
export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string | null;
  noindex?: boolean;
  structuredData?: boolean;
}

const {
  title = 'Arca Computer — AI-native product company',
  description = 'Arca Computer, Inc. is an AI-native product company building open-source agent operations software, developer infrastructure, and consumer applications.',
  canonicalPath = '/',
  noindex = false,
  structuredData = true,
} = Astro.props;
const canonicalURL = canonicalPath === null ? null : new URL(canonicalPath, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
<meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d1412" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="author" content="Arca Computer, Inc." />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arca Computer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content="https://arca.computer/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Arca Computer — The company is the computer." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://arca.computer/og-image.png" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Manrope:wght@400;500;600&display=swap"
    />
    <link rel="stylesheet" href="/styles.css" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    {structuredData && (
      <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Arca Computer, Inc.",
        "alternateName": "Arca Computer",
        "url": "https://arca.computer/",
        "logo": "https://arca.computer/icon-512.png",
        "description": "An AI-native product company building open-source agent operations software, developer infrastructure, and consumer applications.",
        "foundingDate": "2026",
        "email": "contact@arca.computer",
        "founder": {
          "@type": "Person",
          "name": "Luis Felipe Abarca",
          "url": "https://felirami.com/"
        },
        "location": {
          "@type": "Place",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Santiago",
            "addressCountry": "CL"
          }
        },
        "sameAs": [
          "https://arcabot.ai/",
          "https://github.com/arcabotai",
          "https://farcaster.xyz/felirami.eth"
        ]
      }
      </script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
