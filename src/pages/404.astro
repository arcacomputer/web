---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Arca Computer"
  description="This page could not be found on Arca Computer."
  canonicalPath={null}
  noindex
  structuredData={false}
>
  <main class="error-page" id="content">
    <p class="eyebrow">404 / Signal lost</p>
    <h1>Page not found.</h1>
    <p>The address may have moved, or the artifact may no longer be public.</p>
    <a class="button button-primary" href="/">Return to Arca Computer</a>
  </main>
</BaseLayout>
