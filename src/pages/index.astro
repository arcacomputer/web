---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
<a class="skip-link" href="#content">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <div class="signal-board" aria-hidden="true"></div>

    <header class="masthead">
      <a class="wordmark" href="#top" aria-label="Arca Computer home">
        <span class="mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" focusable="false">
            <path d="M7 24 16 6l9 18M10.5 18h11" />
            <circle cx="16" cy="6" r="1.8" />
          </svg>
        </span>
        <span>Arca Computer</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href="#work">Work</a>
        <a href="#model">Model</a>
        <a href="#network">Network</a>
        <a href="#company">Company</a>
        <a href="/deck">Deck</a>
      </nav>

      <span class="status"><i aria-hidden="true"></i> Santiago · Incorporated 2026</span>
    </header>

    <main id="content" tabindex="-1">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Arca Computer, Inc. / Santiago, Chile</p>
          <h1 id="hero-title"><span class="line line-1"><span>The company</span></span> <span class="line line-2"><span>is the computer.</span></span></h1>
          <p class="lede">
            Arca is an AI-native product company. Humans set direction.
            Specialized agents research, build, verify, and operate software products.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">Explore the work</a>
            <a class="button button-secondary" href="https://oss.arcabot.ai/">Inspect public evidence <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <dl class="hero-index" aria-label="Company profile">
          <div>
            <dt>Entity</dt>
            <dd>Delaware C-Corp</dd>
          </div>
          <div>
            <dt>Base</dt>
            <dd>Santiago, Chile</dd>
          </div>
          <div>
            <dt>Mode</dt>
            <dd>Human direction · agent execution</dd>
          </div>
          <div>
            <dt>Output</dt>
            <dd>Products · developer infrastructure · open source</dd>
          </div>
        </dl>
      </section>

      <section class="build-section" aria-labelledby="build-title">
        <div class="section-heading" data-reveal>
          <p class="section-index">00 / Product company</p>
          <div>
            <h2 id="build-title">One vessel. Many kinds of work.</h2>
            <p>
              Arca builds and operates software products, developer infrastructure, and consumer applications.
              Open-source or proprietary, onchain when useful and ordinary infrastructure when it is not.
              The portfolio is broad. The standard is narrow: ship something real, show the boundary, and leave a receipt.
            </p>
          </div>
        </div>

        <div class="principles" data-reveal-stagger>
          <article>
            <span>01</span>
            <h3>Products</h3>
            <p>
              Developer tools, B2B systems, consumer applications, physical prototypes, and experiments that earn
              their place by working.
            </p>
          </article>
          <article>
            <span>02</span>
            <h3>Agents</h3>
            <p>Persistent, role-specific operators with tools, memory, boundaries, and responsibility for defined work.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Infrastructure</h3>
            <p>Identity, payments, data access, deployment, and operational layers for durable agent systems.</p>
          </article>
        </div>
      </section>

      <section class="section" id="work" aria-labelledby="work-title">
        <div class="section-heading" data-reveal>
          <p class="section-index">01 / Selected work</p>
          <div>
            <h2 id="work-title">Working software, not roadmap confetti.</h2>
            <p>
              Core infrastructure, a live repair product, consumer worlds, and independent protocol tooling.
              Each project keeps its own identity while sharing Arca's operating system.
            </p>
          </div>
        </div>

        <div class="work-grid" data-reveal-stagger>
          <article class="work-card work-card-featured glow">
            <div class="card-topline">
              <span>Primary product</span>
              <span class="status-pill" data-state="open">MIT licensed</span>
            </div>
            <div class="work-mark" aria-hidden="true">CF</div>
            <h3>ClawFix</h3>
            <p>Deterministic diagnostics and guarded repair for broken OpenClaw installations, with optional AI explanation and public source.</p>
            <ul class="tag-list" aria-label="ClawFix capabilities">
              <li>CLI</li><li>Diagnostics</li><li>Repair safety</li>
            </ul>
            <a class="card-link" href="https://clawfix.dev/">Run diagnostics <span aria-hidden="true">↗</span></a>
          </article>

          <article class="work-card work-card-featured glow">
            <div class="card-topline">
              <span>Supporting infrastructure</span>
              <span class="status-pill" data-state="open">Open source</span>
            </div>
            <div class="work-mark" aria-hidden="true">A3</div>
            <h3>A3Stack</h3>
            <p>An SDK and CLI joining agent identity, discovery, payments, data, and account rails in one stack.</p>
            <ul class="tag-list" aria-label="A3Stack capabilities">
              <li>Identity</li><li>Payments</li><li>MCP</li><li>Accounts</li>
            </ul>
            <a class="card-link" href="https://a3stack.arcabot.ai/">Open A3Stack <span aria-hidden="true">↗</span></a>
          </article>

          <article class="work-card glow">
            <div class="card-topline">
              <span>Playable world</span>
              <span class="status-pill" data-state="live">Live</span>
            </div>
            <div class="work-mark" aria-hidden="true">CW</div>
            <h3>Castaway</h3>
            <p>A cozy 3D island with fishing, crab traps, rooms, island chat, a Shells economy, and Farcaster sharing.</p>
            <a class="card-link" href="https://castaway.social/world">Visit the island <span aria-hidden="true">↗</span></a>
          </article>

          <article class="work-card glow">
            <div class="card-topline">
              <span>Farcaster client</span>
              <span class="status-pill" data-state="beta">Public beta</span>
            </div>
            <div class="work-mark" aria-hidden="true">CS</div>
            <h3>Castora</h3>
            <p>An Arca-maintained workspace for fast reading, controlled publishing, profile context, clean embeds, and mobile checks.</p>
            <a class="card-link" href="https://castora.social/">Open Castora <span aria-hidden="true">↗</span></a>
          </article>

          <article class="work-card glow">
            <div class="card-topline">
              <span>Node operations</span>
              <span class="status-pill" data-state="open">Independent tooling</span>
            </div>
            <div class="work-mark" aria-hidden="true">HS</div>
            <h3>Hypersnap Toolkit</h3>
            <p>Install, diagnostics, safe repair, and sanitized support tooling for Hypersnap and Snapchain node operators.</p>
            <a class="card-link" href="https://github.com/arcabotai/hypersnap">Inspect the toolkit <span aria-hidden="true">↗</span></a>
          </article>
        </div>
      </section>

      <section class="section model-section" id="model" aria-labelledby="model-title">
        <div class="section-heading" data-reveal>
          <p class="section-index">02 / Operating model</p>
          <div>
            <h2 id="model-title">Human judgment at the center. Machines with real responsibility.</h2>
            <p>
              Work is split by role, handed off with context, bounded by permissions, and reviewed where errors carry consequence.
              The point is not more automation. It is accountable execution.
            </p>
          </div>
        </div>

        <div class="signal-map" role="img" aria-label="Human direction flows through specialist agent execution to a working public artifact" data-reveal data-draw>
          <div class="signal-copy signal-copy-start">
            <span>Input / 001</span>
            <strong>Human direction</strong>
          </div>
          <div class="signal-copy signal-copy-mid">
            <span>Process / 002</span>
            <strong>Specialist handoff</strong>
          </div>
          <div class="signal-copy signal-copy-end">
            <span>Output / 003</span>
            <strong>Working artifact</strong>
          </div>
          <svg viewBox="0 0 1000 280" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path class="signal-glow" d="M52 202 L260 76 L498 146 L725 54 L946 118" />
            <path class="signal-line" d="M52 202 L260 76 L498 146 L725 54 L946 118" />
            <circle cx="52" cy="202" r="6" />
            <circle cx="260" cy="76" r="6" />
            <circle class="signal-active" cx="498" cy="146" r="7" />
            <circle cx="725" cy="54" r="6" />
            <circle cx="946" cy="118" r="6" />
            <circle class="signal-packet" r="3.2">
              <animateMotion dur="7s" repeatCount="indefinite" path="M52 202 L260 76 L498 146 L725 54 L946 118" />
            </circle>
          </svg>
        </div>

        <ol class="process-grid" data-reveal-stagger data-reveal-line>
          <li><span>01</span><h3>Set direction</h3><p>A person defines the goal, context, risk, and authority boundary.</p></li>
          <li><span>02</span><h3>Route the work</h3><p>The right specialist receives a bounded task instead of a vague mandate.</p></li>
          <li><span>03</span><h3>Exercise reality</h3><p>Agents use source, code, browsers, APIs, and infrastructure to produce the artifact.</p></li>
          <li><span>04</span><h3>Leave a receipt</h3><p>Tests, links, releases, logs, or source records make the result inspectable.</p></li>
        </ol>
      </section>

      <section class="section" id="network" aria-labelledby="network-title">
        <div class="section-heading" data-reveal>
          <p class="section-index">03 / Operator network</p>
          <div>
            <h2 id="network-title">Specialists, not one assistant wearing five hats.</h2>
            <p>
              Arca's agents have distinct roles, contexts, and public identities. The roster below is a role map,
              not a diagram of private infrastructure.
            </p>
          </div>
        </div>

        <div class="agent-grid" data-reveal-stagger>
          <article class="glow">
            <div class="agent-head">
              <span class="agent-code">AR / 01</span>
              <svg class="sigil" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
                <path d="M5 23 14 5l9 18M8.5 17h11" />
                <circle cx="14" cy="5" r="1.6" />
              </svg>
            </div>
            <h3>Arca</h3>
            <strong>Primary operator</strong>
            <p>Strategy, product direction, and durable execution across the company.</p>
          </article>
          <article class="glow">
            <div class="agent-head">
              <span class="agent-code">CD / 02</span>
              <svg class="sigil" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
                <path d="M6 6h16v16H6zM6 22 22 6" />
                <circle cx="22" cy="6" r="1.6" />
              </svg>
            </div>
            <h3>Cad</h3>
            <strong>Scout + builder</strong>
            <p>Experiments, implementation, verification, and deployment.</p>
          </article>
          <article class="glow">
            <div class="agent-head">
              <span class="agent-code">AD / 03</span>
              <svg class="sigil" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
                <path d="M4 23C6 12 12 6 24 6M13 11v12" />
                <circle cx="24" cy="6" r="1.6" />
              </svg>
            </div>
            <h3>Ardea</h3>
            <strong>Knowledge steward</strong>
            <p>Source-backed guidance for Hypersnap, Snapchain, and Farcaster-fork builders.</p>
          </article>
          <article class="glow">
            <div class="agent-head">
              <span class="agent-code">ME / 04</span>
              <svg class="sigil" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
                <path d="M4 9l10 8 10-8M4 16l10 8 10-8" />
                <circle cx="14" cy="17" r="1.6" />
              </svg>
            </div>
            <h3>Meles</h3>
            <strong>OSS release steward</strong>
            <p>Upstream reconnaissance, proof packets, and merge-quality work.</p>
          </article>
          <article class="glow">
            <div class="agent-head">
              <span class="agent-code">CO / 05</span>
              <svg class="sigil" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
                <path d="M3 18C8 8 20 8 25 18M14 10v14" />
                <circle cx="14" cy="10" r="1.6" />
              </svg>
            </div>
            <h3>Corvus</h3>
            <strong>Public signal scout</strong>
            <p>Useful social signal, context, and project texture without filler.</p>
          </article>
        </div>

        <div class="network-note" data-reveal>
          <p>Private topology stays private. Public claims still get receipts.</p>
          <a href="https://arcabot.ai/#public-works">See the wider product network <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="section proof-section" aria-labelledby="proof-title">
        <div class="section-heading" data-reveal>
          <p class="section-index">04 / Public proof</p>
          <div>
            <h2 id="proof-title">Software should leave receipts.</h2>
            <p>
              Public source, licenses, releases, upstream states, and working links are kept distinct.
              Evidence beats the victory lap.
            </p>
          </div>
        </div>

        <div class="metrics-strip" aria-label="Current public engineering metrics" data-reveal-stagger>
          <a class="glow" href="https://oss.arcabot.ai/">
            <strong data-count="75">75</strong>
            <span>Public, non-fork repositories: 11 company · 31 agent · 33 founder</span>
          </a>
          <a class="glow" href="https://www.npmjs.com/package/clawfix">
            <strong data-count="2051" data-suffix="+">2,051+</strong>
            <span>ClawFix npm downloads since February 22, 2026</span>
          </a>
          <a class="glow" href="https://github.com/arcabotai/clawfix">
            <strong data-count="49">49</strong>
            <span>Deterministic ClawFix detectors in the public package and source</span>
          </a>
          <a class="glow" href="https://github.com/arcabotai/arca-openclaw-contributions">
            <strong>Open</strong>
            <span>Upstream ledger with pull requests, reviews, and exact merge states</span>
          </a>
        </div>
        <p class="as-of" data-reveal>Metrics and public status verified August 30, 2026. Unavailable evidence is not counted as live.</p>

        <div class="proof-grid" data-reveal-stagger>
          <a class="glow" href="https://oss.arcabot.ai/">
            <span>01</span><strong>OSS index</strong><small>Licensed repositories, ownership labels, and maintenance boundaries.</small><i aria-hidden="true">↗</i>
          </a>
          <a class="glow" href="https://github.com/arcabotai/arca-openclaw-contributions">
            <span>02</span><strong>Upstream ledger</strong><small>Pull requests, reviews, merge states, and exact public evidence.</small><i aria-hidden="true">↗</i>
          </a>
          <a class="glow" href="https://github.com/arcabotai">
            <span>03</span><strong>GitHub</strong><small>Source, releases, packages, experiments, and working artifacts.</small><i aria-hidden="true">↗</i>
          </a>
          <a class="glow" href="https://arcabot.ai/">
            <span>04</span><strong>Arca ecosystem</strong><small>The wider product catalogue, public agent system, and onchain identity.</small><i aria-hidden="true">↗</i>
          </a>
        </div>
      </section>

      <section class="section company-section" id="company" aria-labelledby="company-title">
        <div class="section-heading" data-reveal>
          <p class="section-index">05 / Company</p>
          <div>
            <h2 id="company-title">Incorporated in Delaware. Built from Santiago.</h2>
            <p>
              Arca Computer, Inc. is a bootstrapped Delaware C-Corporation incorporated in July 2026.
              It grows from years of work across digital art, online communities, Farcaster, web3,
              software, and now agent-driven product development.
            </p>
          </div>
        </div>

        <div class="company-grid">
          <dl class="company-ledger" data-reveal-stagger>
            <div><dt>Legal entity</dt><dd>Arca Computer, Inc.</dd></div>
            <div><dt>Structure</dt><dd>Delaware C-Corporation</dd></div>
            <div><dt>Incorporated</dt><dd>July 2026</dd></div>
            <div><dt>Operating base</dt><dd>Santiago, Chile</dd></div>
            <div><dt>Stage</dt><dd>Bootstrapped</dd></div>
            <div><dt>Primary work</dt><dd>Products · developer infrastructure · open source</dd></div>
          </dl>

          <article class="founder-card glow" data-reveal>
            <span class="monogram" aria-hidden="true">LFA</span>
            <p class="section-index">Founder / 001</p>
            <h3>Luis Felipe Abarca</h3>
            <p>
              Chilean artist, product builder, and agent operator. Luis has built across creative communities,
              onchain social systems, and practical software since 2021. He is also a Cerebras Community Ambassador
              for Chile and Latin America.
            </p>
            <div class="founder-links">
              <a href="https://felirami.com/">Website <span aria-hidden="true">↗</span></a>
              <a href="https://farcaster.xyz/felirami.eth">Farcaster <span aria-hidden="true">↗</span></a>
              <a href="https://github.com/felirami">GitHub <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title" data-reveal-stagger>
        <p class="section-index">06 / Contact</p>
        <div>
          <h2 id="contact-title">Build with Arca's products.</h2>
          <p>For product access, open-source collaboration, developer integrations, or technical partnerships, write directly.</p>
        </div>
        <div class="contact-actions">
          <a class="contact-link" href="mailto:contact@arca.computer">contact@arca.computer <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="/deck">Read the company deck <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <footer data-reveal-stagger>
      <span class="footer-mark" aria-hidden="true">ARCA</span>
      <div>
        <strong>Arca Computer, Inc.</strong>
        <span>Delaware C-Corporation · Santiago, Chile</span>
      </div>
      <p>Independent unless explicitly stated. Product and protocol names belong to their respective owners.</p>
      <nav aria-label="Footer navigation">
        <a href="/deck">Deck</a>
        <a href="https://github.com/arcabotai">GitHub</a>
        <a href="https://arcabot.ai/">Arca</a>
        <a href="mailto:contact@arca.computer">Contact</a>
      </nav>
      <span>© 2026</span>
    </footer>

    <script>
      import { initMotion } from '../scripts/motion';
      import { mountSignalBoard } from '../scripts/signal-board';

      initMotion();
      const board = document.querySelector<HTMLElement>('.signal-board');
      if (board) mountSignalBoard(board);
    </script>
</BaseLayout>
